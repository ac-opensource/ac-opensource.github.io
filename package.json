{
  "name": "ac-opensource-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static portfolio and published-only blog generated from an authoring-only SQLite database",
  "engines": {
    "node": ">=24 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24 <25",
      "onFail": "error"
    }
  },
  "scripts": {
    "blog:db:init": "node scripts/init-blog-db.js",
    "blog:db:import": "node scripts/import-blog-into-db.js",
    "blog:db:sync": "node scripts/sync-blog-from-db.js",
    "blog:build": "node scripts/build-static-blog-pages.js",
    "blog:query": "node scripts/query-blog-db.js",
    "blog:writer": "node scripts/blog-writer-server.js",
    "blog:new": "node scripts/new-post.js",
    "work:seed": "node scripts/seed-work-deep-dives.js",
    "build": "node scripts/build-site.js",
    "verify:dist": "node scripts/verify-dist.js",
    "verify:deterministic": "node scripts/check-deterministic-build.js",
    "test:build": "node scripts/test-build-pipeline.js",
    "test:writer": "node scripts/test-blog-writer-security.js",
    "test:contact-apps-script": "node scripts/test-contact-apps-script.js",
    "test:contact-signals": "node scripts/test-contact-signals.js",
    "test:contact-signals:browser": "node scripts/test-contact-signals-browser.js",
    "test:contact-apps-script-verifier": "node scripts/test-contact-apps-script-verifier.js",
    "test:options": "node scripts/test-universe-options.js",
    "contact-signals:local": "node scripts/local-contact-signals-server.js",
    "contact:verify-apps-script": "node scripts/verify-contact-apps-script.js",
    "verify": "npm run build && npm run verify:dist && npm run verify:deterministic && npm run test:build && npm run test:writer && npm run test:contact-apps-script && npm run test:contact-signals && npm run test:contact-apps-script-verifier",
    "test:e2e": "node scripts/run-e2e.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "playwright": "^1.58.2",
    "tailwindcss": "^3.4.19"
  }
}
